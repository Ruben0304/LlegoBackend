# MongoDB Configuration
MONGODB_URL=mongodb://user:password@host:port/
MONGODB_DATABASE=llego

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT=60

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
QUERY_TASK_TYPE=RETRIEVAL_QUERY

# DeepSeek API Configuration (AI Chat RAG)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI Assistant Quota Configuration
AI_FREE_LIFETIME_LIMIT=2
AI_PRO_MONTHLY_LIMIT=60
AI_USAGE_COLLECTION=ai_quota_usage

# Authentication Configuration
GOOGLE_CLIENT_ID=your-google-client-id
APPLE_CLIENT_ID=your-apple-client-id
# Optional explicit allowlist for Apple token audiences (comma-separated).
# If empty, APPLE_CLIENT_ID is used (backward compatible).
APPLE_ALLOWED_AUDIENCES=your-main-app-bundle-id,org.example.project.appmensajeros3978ubka75
JWT_SECRET=your-jwt-secret-key

# Apple Push Notifications (APNs)
APNS_BUNDLE_ID=com.yourapp.bundle
APNS_KEY_ID=your-apns-key-id
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour P8 key content here\n-----END PRIVATE KEY-----
APNS_USE_SANDBOX=true

# Apple Web Auth (for Android/Web)
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour P8 key content here\n-----END PRIVATE KEY-----
APPLE_WEB_SERVICE_ID=your-apple-service-id
APPLE_WEB_REDIRECT_URI=https://yourapp.com/auth/callback

# CORS Configuration
CORS_ORIGINS_STR=http://localhost:3000,https://yourapp.com

# Environment
ENVIRONMENT=development

# Redis Configuration (Rate Limiting)
REDIS_URL=redis://localhost:6379

# Cache Configuration
CACHE_ENABLED=true
CACHE_ALL_ON_STARTUP=false
CACHE_TTL=1800
CACHE_PRESIGNED_URL_TTL=3000

# iOS Shortcuts API Key
SHORTCUTS_API_KEY=your-shortcuts-api-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET_NAME=your-bucket-name
